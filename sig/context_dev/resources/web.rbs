module ContextDev
  module Resources
    class Web
      def extract: (
        schema: ::Hash[Symbol, top],
        url: String,
        ?fact_check: bool,
        ?follow_subdomains: bool,
        ?include_frames: bool,
        ?instructions: String,
        ?max_age_ms: Integer,
        ?max_depth: Integer,
        ?max_pages: Integer,
        ?pdf: ContextDev::WebExtractParams::Pdf,
        ?settle_animations: bool,
        ?stop_after_ms: Integer,
        ?tags: ::Array[String],
        ?timeout_ms: Integer,
        ?wait_for_ms: Integer,
        ?request_options: ContextDev::request_opts
