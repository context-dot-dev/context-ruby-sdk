module ContextDev
  module Resources
    class Web
      def answers: (
        task: String,
        ?json_format: ::Hash[Symbol, top],
        ?mode: ContextDev::Models::WebAnswersParams::mode,
        ?tags: ::Array[String],
        ?timeout_opts: ContextDev::WebAnswersParams::TimeoutOpts,
        ?zdr: ContextDev::Models::WebAnswersParams::zdr,
        ?request_options: ContextDev::request_opts
      ) -> ContextDev::Models::WebAnswersResponse

      def extract_competitors: (
        domain: String,
        ?num_competitors: Integer,
        ?tags: ::Array[String],
        ?timeout_opts: ContextDev::WebExtractCompetitorsParams::TimeoutOpts,
        ?zdr: ContextDev::Models::WebExtractCompetitorsParams::zdr,
        ?request_options: ContextDev::request_opts
      ) -> ContextDev::Models::WebExtractCompetitorsResponse

      def extract_styleguide: (
        ?color_scheme: ContextDev::Models::WebExtractStyleguideParams::color_scheme,
        ?direct_url: String,
        ?domain: String,
        ?max_age_ms: Integer?,
        ?tags: ::Array[String],
        ?timeout_opts: ContextDev::WebExtractStyleguideParams::TimeoutOpts,
        ?zdr: ContextDev::Models::WebExtractStyleguideParams::zdr,
        ?request_options: ContextDev::request_opts
      ) -> ContextDev::Models::WebExtractStyleguideResponse

      def map_urls: (
        domain: String,
        ?headers: ::Hash[Symbol, String],
        ?include_subdomains: bool,
        ?max_links: Integer,
        ?search: String,
        ?sitemap_url: String,
        ?tags: ::Array[String],
        ?timeout_opts: ContextDev::WebMapURLsParams::TimeoutOpts,
        ?url_regex: String,
        ?zdr: ContextDev::Models::WebMapURLsParams::zdr,
        ?request_options: ContextDev::request_opts
      ) -> ContextDev::Models::WebMapURLsResponse

      def scrape: (
        formats: ContextDev::WebScrapeParams::Formats,
        url: String,
        ?highlights_params: ContextDev::WebScrapeParams::HighlightsParams,
        ?image_params: ContextDev::WebScrapeParams::ImageParams,
        ?json_params: ContextDev::WebScrapeParams::JsonParams,
        ?markdown_params: ContextDev::WebScrapeParams::MarkdownParams,
        ?max_age_ms: Integer,
        ?parse_params: ContextDev::WebScrapeParams::ParseParams,
        ?product_params: ContextDev::WebScrapeParams::ProductParams,
        ?screenshot_params: ContextDev::WebScrapeParams::ScreenshotParams,
        ?shared_params: ContextDev::WebScrapeParams::SharedParams,
        ?tags: ::Array[String],
        ?timeout_opts: ContextDev::WebScrapeParams::TimeoutOpts,
        ?zdr: ContextDev::Models::WebScrapeParams::zdr,
        ?request_options: ContextDev::request_opts
      ) -> ContextDev::Models::WebScrapeResponse

      def screenshot: (
        ?clear_popups: bool,
        ?color_scheme: ContextDev::Models::WebScreenshotParams::color_scheme,
        ?country: ContextDev::Models::WebScreenshotParams::country,
        ?direct_url: String,
        ?domain: String,
        ?full_screenshot: ContextDev::Models::WebScreenshotParams::full_screenshot,
        ?handle_cookie_popup: bool,
        ?headers: ::Hash[Symbol, String],
        ?max_age_ms: Integer?,
        ?page: ContextDev::Models::WebScreenshotParams::page,
        ?scroll_offset: Integer?,
        ?tags: ::Array[String],
        ?timeout_opts: ContextDev::WebScreenshotParams::TimeoutOpts,
        ?viewport: ContextDev::WebScreenshotParams::Viewport,
        ?wait_for_ms: Integer?,
        ?zdr: ContextDev::Models::WebScreenshotParams::zdr,
        ?request_options: ContextDev::request_opts
      ) -> ContextDev::Models::WebScreenshotResponse

      def search: (
        query: String,
        ?country: ContextDev::Models::WebSearchParams::country,
        ?description_max_characters: Integer?,
        ?exclude_domains: ::Array[String],
        ?freshness: ContextDev::Models::WebSearchParams::freshness,
        ?highlights_options: ContextDev::WebSearchParams::HighlightsOptions?,
        ?include_domains: ::Array[String],
        ?markdown_options: ContextDev::WebSearchParams::MarkdownOptions?,
        ?num_results: Integer,
        ?query_fanout: bool,
        ?tags: ::Array[String],
        ?timeout_opts: ContextDev::WebSearchParams::TimeoutOpts,
        ?zdr: ContextDev::Models::WebSearchParams::zdr,
        ?request_options: ContextDev::request_opts
      ) -> ContextDev::Models::WebSearchResponse

      def web_crawl_md: (
        url: String,
        ?country: ContextDev::Models::WebWebCrawlMdParams::country,
        ?exclude_selectors: ::Array[String]?,
        ?follow_subdomains: bool,
        ?include_frames: bool,
        ?include_images: bool,
        ?include_links: bool,
        ?include_selectors: ::Array[String]?,
        ?max_age_ms: Integer?,
        ?max_depth: Integer,
        ?max_pages: Integer,
        ?pdf: ContextDev::WebWebCrawlMdParams::Pdf,
        ?settle_animations: bool,
        ?shorten_base64_images: bool,
        ?stop_after_ms: Integer,
        ?tags: ::Array[String],
        ?timeout_opts: ContextDev::WebWebCrawlMdParams::TimeoutOpts,
        ?url_regex: String,
        ?use_main_content_only: bool,
        ?wait_for_ms: Integer?,
        ?zdr: ContextDev::Models::WebWebCrawlMdParams::zdr,
        ?request_options: ContextDev::request_opts
      ) -> ContextDev::Models::WebWebCrawlMdResponse

      def initialize: (client: ContextDev::Client) -> void
    end
  end
end
