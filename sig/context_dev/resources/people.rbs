module ContextDev
  module Resources
    class People
      def enrich: (
        ?company: ContextDev::PersonEnrichParams::Company,
        ?education: ::Array[ContextDev::PersonEnrichParams::Education],
        ?email: String,
        ?location: ContextDev::PersonEnrichParams::Location,
        ?name: ContextDev::PersonEnrichParams::Name,
        ?social_urls: ::Array[String],
        ?tags: ::Array[String],
        ?timeout_opts: ContextDev::PersonEnrichParams::TimeoutOpts,
        ?zdr: ContextDev::Models::PersonEnrichParams::zdr,
        ?request_options: ContextDev::request_opts
      ) -> ContextDev::Models::PersonEnrichResponse

      def search: (
        query: String,
        ?cursor: String,
        ?filters: ContextDev::PersonSearchParams::Filters,
        ?mode: ContextDev::Models::PersonSearchParams::mode,
        ?tags: ::Array[String],
        ?request_options: ContextDev::request_opts
      ) -> ContextDev::Models::PersonSearchResponse

      def initialize: (client: ContextDev::Client) -> void
    end
  end
end
