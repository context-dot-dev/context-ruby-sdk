          String delivery_id,
          ?tags: ::Array[String],
          ?request_options: ContextDev::request_opts
        ) -> ContextDev::Models::Webhooks::DeliveryRetrieveResponse

        def list: (
          ?batch_id: String,
          ?cursor: String,
          ?limit: Integer,
          ?monitor_id: String,
          ?run_id: String,
          ?status: ContextDev::Models::Webhooks::DeliveryListParams::status,
          ?tags: ::Array[String],
          ?request_options: ContextDev::request_opts
        ) -> ContextDev::Models::Webhooks::DeliveryListResponse

        def list_attempts: (
