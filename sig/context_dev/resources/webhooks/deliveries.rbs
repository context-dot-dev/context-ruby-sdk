          ?cursor: String,
          ?limit: Integer,
          ?tags: ::Array[String],
          ?request_options: ContextDev::request_opts
        ) -> ContextDev::Models::Webhooks::DeliveryListAttemptsResponse

        def retry_: (
          String delivery_id,
          ?force: bool,
          ?tags: ::Array[String],
