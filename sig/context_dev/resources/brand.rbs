module ContextDev
  module Resources
    class Brand
      def retrieve: (
        body: ContextDev::Models::BrandRetrieveParams::body,
        ?request_options: ContextDev::request_opts
      ) -> ContextDev::Models::BrandRetrieveResponse

      def retrieve_simplified: (
        domain: String,
        ?max_age_ms: Integer?,
        ?tags: ::Array[String],
        ?theme: ContextDev::Models::BrandRetrieveSimplifiedParams::theme,
        ?timeout_ms: Integer,
        ?request_options: ContextDev::request_opts
      ) -> ContextDev::Models::BrandRetrieveSimplifiedResponse

      def search: (
        query: String,
        ?tags: ::Array[String],
        ?request_options: ContextDev::request_opts
      ) -> ContextDev::Models::BrandSearchResponse

      def initialize: (client: ContextDev::Client) -> void
    end
  end
end
