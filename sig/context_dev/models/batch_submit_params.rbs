module ContextDev
  module Models
    type batch_submit_params =
      {
        identifiers: ContextDev::BatchSubmitParams::Identifiers,
        tags: ::Array[String],
        timeout_ms: Integer
      }
      & ContextDev::Internal::Type::request_parameters

    class BatchSubmitParams < ContextDev::Internal::Type::BaseModel
      extend ContextDev::Internal::Type::RequestParameters::Converter
      include ContextDev::Internal::Type::RequestParameters

      attr_accessor identifiers: ContextDev::BatchSubmitParams::Identifiers

      attr_reader tags: ::Array[String]?

      def tags=: (::Array[String]) -> ::Array[String]

      attr_reader timeout_ms: Integer?

      def timeout_ms=: (Integer) -> Integer

      def initialize: (
        identifiers: ContextDev::BatchSubmitParams::Identifiers,
        ?tags: ::Array[String],
        ?timeout_ms: Integer,
        ?request_options: ContextDev::request_opts
      ) -> void

      def to_hash: -> {
        identifiers: ContextDev::BatchSubmitParams::Identifiers,
        tags: ::Array[String],
        timeout_ms: Integer,
        request_options: ContextDev::RequestOptions
      }

      type identifiers = { linkedin_url: String }

      class Identifiers < ContextDev::Internal::Type::BaseModel
        attr_reader linkedin_url: String?

        def linkedin_url=: (String) -> String

        def initialize: (?linkedin_url: String) -> void

        def to_hash: -> { linkedin_url: String }
      end
    end
  end
end
