module ContextDev
  module Models
    module Webhooks
      type delivery_summary =
        {
          id: String,
          created_at: Time,
          delivered_at: Time?,
          event: ContextDev::Models::Webhooks::DeliverySummary::event,
          last_error: ContextDev::Webhooks::DeliverySummary::LastError?,
          next_attempt_at: Time?,
          retry_expires_at: Time,
          source: ContextDev::Models::Webhooks::DeliverySummary::source,
          status: ContextDev::Models::Webhooks::DeliverySummary::status,
          url: String
        }

      class DeliverySummary < ContextDev::Internal::Type::BaseModel
        attr_accessor id: String

        attr_accessor created_at: Time

        attr_accessor delivered_at: Time?

        attr_accessor event: ContextDev::Models::Webhooks::DeliverySummary::event

        attr_accessor last_error: ContextDev::Webhooks::DeliverySummary::LastError?

        attr_accessor next_attempt_at: Time?

        attr_accessor retry_expires_at: Time

        attr_accessor source: ContextDev::Models::Webhooks::DeliverySummary::source

        attr_accessor status: ContextDev::Models::Webhooks::DeliverySummary::status

        attr_accessor url: String

        def initialize: (
          id: String,
          created_at: Time,
          delivered_at: Time?,
          event: ContextDev::Models::Webhooks::DeliverySummary::event,
          last_error: ContextDev::Webhooks::DeliverySummary::LastError?,
          next_attempt_at: Time?,
          retry_expires_at: Time,
          source: ContextDev::Models::Webhooks::DeliverySummary::source,
          status: ContextDev::Models::Webhooks::DeliverySummary::status,
          url: String
        ) -> void

        def to_hash: -> {
          id: String,
          created_at: Time,
          delivered_at: Time?,
          event: ContextDev::Models::Webhooks::DeliverySummary::event,
          last_error: ContextDev::Webhooks::DeliverySummary::LastError?,
          next_attempt_at: Time?,
          retry_expires_at: Time,
          source: ContextDev::Models::Webhooks::DeliverySummary::source,
          status: ContextDev::Models::Webhooks::DeliverySummary::status,
          url: String
        }

        type event =
          :"batch.completed"
          | :"batch.failed"
          | :"batch.cancelled"
          | :"change.detected"
          | :"run.completed"

        module Event
          extend ContextDev::Internal::Type::Enum

          BATCH_COMPLETED: :"batch.completed"
          BATCH_FAILED: :"batch.failed"
          BATCH_CANCELLED: :"batch.cancelled"
          CHANGE_DETECTED: :"change.detected"
          RUN_COMPLETED: :"run.completed"

          def self?.values: -> ::Array[ContextDev::Models::Webhooks::DeliverySummary::event]
        end

        type last_error = { code: String, message: String }

        class LastError < ContextDev::Internal::Type::BaseModel
          attr_accessor code: String

          attr_accessor message: String

          def initialize: (code: String, message: String) -> void

          def to_hash: -> { code: String, message: String }
        end

        type source =
          ContextDev::Webhooks::DeliverySummary::Source::Batch
          | ContextDev::Webhooks::DeliverySummary::Source::Monitor

        module Source
          extend ContextDev::Internal::Type::Union

          type batch =
            {
              batch_id: String,
              type: ContextDev::Models::Webhooks::DeliverySummary::Source::Batch::type_
            }

          class Batch < ContextDev::Internal::Type::BaseModel
            attr_accessor batch_id: String

            attr_accessor type: ContextDev::Models::Webhooks::DeliverySummary::Source::Batch::type_

            def initialize: (
              batch_id: String,
              type: ContextDev::Models::Webhooks::DeliverySummary::Source::Batch::type_
            ) -> void

            def to_hash: -> {
              batch_id: String,
              type: ContextDev::Models::Webhooks::DeliverySummary::Source::Batch::type_
            }

            type type_ = :batch

            module Type
              extend ContextDev::Internal::Type::Enum

              BATCH: :batch

              def self?.values: -> ::Array[ContextDev::Models::Webhooks::DeliverySummary::Source::Batch::type_]
            end
          end

          type monitor =
            {
              monitor_id: String,
              run_id: String,
              type: ContextDev::Models::Webhooks::DeliverySummary::Source::Monitor::type_
            }

          class Monitor < ContextDev::Internal::Type::BaseModel
            attr_accessor monitor_id: String

            attr_accessor run_id: String

            attr_accessor type: ContextDev::Models::Webhooks::DeliverySummary::Source::Monitor::type_

            def initialize: (
              monitor_id: String,
              run_id: String,
              type: ContextDev::Models::Webhooks::DeliverySummary::Source::Monitor::type_
            ) -> void

            def to_hash: -> {
              monitor_id: String,
              run_id: String,
              type: ContextDev::Models::Webhooks::DeliverySummary::Source::Monitor::type_
            }

            type type_ = :monitor

            module Type
              extend ContextDev::Internal::Type::Enum

              MONITOR: :monitor

              def self?.values: -> ::Array[ContextDev::Models::Webhooks::DeliverySummary::Source::Monitor::type_]
            end
          end

          def self?.variants: -> ::Array[ContextDev::Models::Webhooks::DeliverySummary::source]
        end

        type status =
          :pending | :delivering | :retrying | :delivered | :failed | :cancelled

        module Status
          extend ContextDev::Internal::Type::Enum

          PENDING: :pending
          DELIVERING: :delivering
          RETRYING: :retrying
          DELIVERED: :delivered
          FAILED: :failed
          CANCELLED: :cancelled

          def self?.values: -> ::Array[ContextDev::Models::Webhooks::DeliverySummary::status]
        end
      end
    end
  end
end
