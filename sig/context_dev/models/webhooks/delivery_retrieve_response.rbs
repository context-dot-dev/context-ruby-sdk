module ContextDev
  module Models
    module Webhooks
      type delivery_retrieve_response =
        {
          request_id: String,
          key_metadata: ContextDev::Models::Webhooks::DeliveryRetrieveResponse::KeyMetadata
        }

      class DeliveryRetrieveResponse < ContextDev::Models::Webhooks::Delivery
        def request_id: -> String

        def request_id=: (String _) -> String

        def key_metadata: -> ContextDev::Models::Webhooks::DeliveryRetrieveResponse::KeyMetadata?

        def key_metadata=: (
          ContextDev::Models::Webhooks::DeliveryRetrieveResponse::KeyMetadata _
        ) -> ContextDev::Models::Webhooks::DeliveryRetrieveResponse::KeyMetadata

        def initialize: (
          request_id: String,
          ?key_metadata: ContextDev::Models::Webhooks::DeliveryRetrieveResponse::KeyMetadata
        ) -> void

        def to_hash: -> {
          request_id: String,
          key_metadata: ContextDev::Models::Webhooks::DeliveryRetrieveResponse::KeyMetadata
        }

        type key_metadata =
          { credits_consumed: Integer, credits_remaining: Integer }

        class KeyMetadata < ContextDev::Internal::Type::BaseModel
          attr_accessor credits_consumed: Integer

          attr_accessor credits_remaining: Integer

          def initialize: (
            credits_consumed: Integer,
            credits_remaining: Integer
          ) -> void

          def to_hash: -> {
            credits_consumed: Integer,
            credits_remaining: Integer
          }
        end
      end
    end
  end
end
