module ContextDev
  module Models
    type monitor_run_response =
      {
        monitor_id: String,
        queued: bool,
        request_id: String,
        run_id: String,
        key_metadata: ContextDev::Models::MonitorRunResponse::KeyMetadata
      }

    class MonitorRunResponse < ContextDev::Internal::Type::BaseModel
      attr_accessor monitor_id: String

      attr_accessor queued: bool

      attr_accessor request_id: String

      attr_accessor run_id: String

      attr_reader key_metadata: ContextDev::Models::MonitorRunResponse::KeyMetadata?

      def key_metadata=: (
        ContextDev::Models::MonitorRunResponse::KeyMetadata
      ) -> ContextDev::Models::MonitorRunResponse::KeyMetadata

      def initialize: (
        monitor_id: String,
        queued: bool,
        request_id: String,
        run_id: String,
        ?key_metadata: ContextDev::Models::MonitorRunResponse::KeyMetadata
      ) -> void

      def to_hash: -> {
        monitor_id: String,
        queued: bool,
        request_id: String,
        run_id: String,
        key_metadata: ContextDev::Models::MonitorRunResponse::KeyMetadata
      }

      type key_metadata =
        { credits_consumed: Integer, credits_remaining: Integer }

      class KeyMetadata < ContextDev::Internal::Type::BaseModel
        attr_accessor credits_consumed: Integer

        attr_accessor credits_remaining: Integer

        def initialize: (
          credits_consumed: Integer,
          credits_remaining: Integer
        ) -> void

        def to_hash: -> {
          credits_consumed: Integer,
          credits_remaining: Integer
        }
      end
    end
  end
end
